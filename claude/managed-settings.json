{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__([^v]|v[^2]|v2[^b]|v2b[^_]|v2b_[^_])",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/v2b/bin/v2b agent only-reads --log /home/v2b-agent/use-log/tool.jsonl",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t: (now | todate), run: ($ENV.V2B_RUN // \"session\"), session_id: (.session_id // null), prompt_id: (.prompt_id // null), prompt: (.prompt // null)}' >> /home/v2b-agent/use-log/prompt.jsonl || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t: (now | todate), run: ($ENV.V2B_RUN // \"session\"), session_id: (.session_id // null), prompt_id: (.prompt_id // null), tool_use_id: (.tool_use_id // null), tool_name: (.tool_name // null), tool_input} + ((.tool_response | tojson) as $s | if ($s | length) <= 8192 then {tool_response} else {tool_response: $s[0:8192], truncated: true} end)' >> /home/v2b-agent/use-log/tool.jsonl || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t: (now | todate), run: ($ENV.V2B_RUN // \"session\"), session_id: (.session_id // null), prompt_id: (.prompt_id // null), tool_use_id: (.tool_use_id // null), tool_name: (.tool_name // null), tool_input, error: (.error // null)}' >> /home/v2b-agent/use-log/tool.jsonl || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t: (now | todate), run: ($ENV.V2B_RUN // \"session\"), session_id: (.session_id // null), prompt_id: (.prompt_id // null), cwd: (.cwd // null), transcript_path: (.transcript_path // null), last_assistant_message: (.last_assistant_message // null)}' >> /home/v2b-agent/use-log/stop.jsonl || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$V2B_RUN\" in summarize|ledger|digest) ;; *) /usr/local/lib/v2b/bin/v2b-now --start 2>/dev/null ;; esac; true"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "availableModels": ["opus"],
  "enforceAvailableModels": true,
  "permissions": {
    "allow": [
      "Bash(/usr/local/lib/v2b/bin/v2b-search *)",
      "Bash(v2b-search *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-dates *)",
      "Bash(v2b-dates *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-day *)",
      "Bash(v2b-day *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-who-took-part *)",
      "Bash(v2b-who-took-part *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-message-history *)",
      "Bash(v2b-message-history *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-as-received *)",
      "Bash(v2b-as-received *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-what-is-copied *)",
      "Bash(v2b-what-is-copied *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-query *)",
      "Bash(v2b-query *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-what-may-need-you *)",
      "Bash(v2b-what-may-need-you *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-now *)",
      "Bash(v2b-now *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-status *)",
      "Bash(v2b-status *)",
      "Bash(/usr/local/lib/v2b/bin/v2b status *)",
      "Bash(v2b status *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-copy-now *)",
      "Bash(v2b-copy-now *)",
      "Bash(/usr/local/lib/v2b/bin/v2b sync *)",
      "Bash(v2b sync *)",
      "Bash(/usr/local/lib/v2b/bin/v2b-your-accounts)",
      "Bash(v2b-your-accounts)",
      "mcp__v2b__search_messages",
      "mcp__v2b__read_thread",
      "mcp__v2b__read_conversation",
      "mcp__v2b__messages_by_person",
      "mcp__v2b__what_may_need_you",
      "mcp__v2b__list",
      "mcp__v2b__copy_status",
      "mcp__v2b__copy_now",
      "mcp__v2b__what_you_told_v2b",
      "Edit(./reports/**)"
    ]
  },
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverCommand": ["/usr/local/lib/v2b/bin/v2b", "mcp"] },
    { "serverUrl": "https://*" }
  ],
  "allowAllClaudeAiMcps": true,
  "allowManagedHooksOnly": true,
  "autoMemoryEnabled": false
}
