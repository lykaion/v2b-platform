[Unit]
Description=V2B keep the candidates and to-dos once a conversation with the agent goes quiet
# The agent's Stop hook appends a line to stop.jsonl at the end of every turn. A change starts the
# ledger, which waits until no turn has ended for five minutes before it reads; a turn ending while
# it runs is read by the next run.

[Path]
PathModified=/home/v2b-agent/use-log/stop.jsonl
Unit=v2b-ledger.service

[Install]
WantedBy=multi-user.target
