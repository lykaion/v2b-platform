[Unit]
Description=V2B update Claude Code once a day

[Timer]
# OnActiveSec gives the first firing on a server not rebooted since the install: OnBootSec is
# long past there, and OnUnitActiveSec needs a run before it (docs/checks.md, the puller).
OnActiveSec=20min
OnBootSec=20min
OnUnitActiveSec=1d
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
