[Unit]
Description=V2B Remote Control server
After=network-online.target
Wants=network-online.target
# Claude's sign-in writes this file; until it exists the unit is skipped, never failed, and
# setup's remote-control stage starts it once the sign-in is done.
ConditionPathExists=/home/v2b-agent/.claude/.credentials.json

[Service]
User=v2b-agent
WorkingDirectory=/home/v2b-agent/workspace
# Claude Code is root's, in /usr/local/lib/claude-code: the agent's user runs it and cannot replace it. Root
# installs it here when it is missing ("+": as root, outside the lines below; a server set up
# before root's copy existed gets it on this start), and updates it on v2b-claude-update.timer.
ExecStartPre=+/usr/local/lib/v2b/current/bin/v2b claude-update --if-missing
TimeoutStartSec=10min
# V2B's commands are on the path, as in every other run of the agent, so the agent calls them by
# name; the managed settings let those names run with no review by auto mode.
Environment=PATH=/usr/local/lib/claude-code/.local/bin:/usr/local/lib/v2b/bin:/usr/local/bin:/usr/bin:/bin
# Claude Code's own updater is off: it would write a copy of its own into v2b-agent's home.
Environment=DISABLE_AUTOUPDATER=1
ExecStart=/usr/local/lib/v2b/current/bin/v2b remote-control-run /usr/local/lib/claude-code/.local/bin/claude remote-control --spawn same-dir --permission-mode auto --name v2b
Restart=always
# Retried without end, each wait longer than the last, from 5 seconds up to 10 minutes over ten
# restarts: an installer or a network that is down for an hour is tried again, never hammered.
RestartSec=5
RestartSteps=10
RestartMaxDelaySec=10min
# Standard output is a status Claude redraws once a second (360 lines a minute when idle): it goes
# nowhere. Standard error, where Claude says why it stops, goes to a file of root's, not the
# journal, so nothing of the agent's sessions reaches the journal. `v2b remote-control-run`, the
# start above, passes it on and holds the file under 64 KiB however long the run, the end kept;
# after each run, root keeps the last of it when the run failed and empties it ("-": a failure
# here never holds up a restart). `v2b state` and the setup show the kept words.
StandardOutput=null
StandardError=append:/run/v2b-remote-control.stderr
ExecStopPost=-+/usr/local/lib/v2b/current/bin/v2b remote-control-ended
# What the agent, and every command it runs, may reach. Each line keeps Claude Code working
# (measured on the dry-run box under these lines); none of them limits the network, which is
# open by ruling.
# The archive service's keys and state, hidden: not there in the agent's view.
InaccessiblePaths=-/etc/v2b -/var/lib/v2b/archive
UMask=0077
# No privilege gained through setuid binaries (sudo, su) or file capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# The whole file system read-only but the agent's home; /tmp its own.
ProtectSystem=strict
ReadWritePaths=/home/v2b-agent
PrivateTmp=yes
# No devices but the pseudo ones; the kernel's tunables, modules, logs, clock, hostname and
# cgroups out of reach; other users' processes invisible.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Sockets of the kinds a program on the network uses (the archive socket is AF_UNIX).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
