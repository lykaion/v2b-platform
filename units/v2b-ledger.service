[Unit]
Description=V2B keep the candidates and to-dos from the owner's conversations, the reports and the summaries
After=network-online.target
Wants=network-online.target
# Claude's sign-in is the agent's; until it exists there is no model to ask, and the run is skipped.
ConditionPathExists=/home/v2b-agent/.claude/.credentials.json

[Service]
Type=oneshot
User=v2b-agent
WorkingDirectory=/home/v2b-agent/workspace
Environment=PATH=/usr/local/lib/claude-code/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISABLE_AUTOUPDATER=1
# Started by v2b-ledger.path when a turn of the agent's ends, and nightly by v2b-ledger.timer; it
# first waits until no turn has ended for five minutes, so it reads what he said once he is done.
ExecStart=/usr/local/lib/v2b/current/bin/v2b ledger --quiet 5m
TimeoutStartSec=1h
Nice=10
# The ledger runs Claude Code with no tool (internal/ledger): the model reads his turns, the
# reports' lines and the summaries' as text and answers lines, which this program checks and
# writes under candidates/ and todos/ alone. It reads no copy and no key.
# The lines are the agent's unit's (v2b-remote-control.service).
InaccessiblePaths=-/etc/v2b -/var/lib/v2b/archive
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectSystem=strict
ReadWritePaths=/home/v2b-agent
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
